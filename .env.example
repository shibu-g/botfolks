# ---------- App ----------
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
WIDGET_URL=http://localhost:5174
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Database ----------
# Local dev: point at your local MySQL server, then run db/local/001_init_local.sql against DB_NAME.
# Production: these are read by docker-compose.yml to provision the MariaDB 11.8 container.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=botfolks
DB_USER=root
DB_PASSWORD=
DB_ROOT_PASSWORD=root_pass

# ---------- Queue ----------
# local = worker polls MySQL for pending sources, no Redis/Docker needed. redis = BullMQ (production).
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=sk-or-xxxx
CHAT_MODEL=anthropic/claude-haiku-5.5
CHAT_MODEL_FALLBACK=google/gemini-2.5-flash-lite
EMBED_MODEL=baai/bge-m3
EMBED_DIM=1024

# ---------- Payments (Dodo) ----------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Create one recurring (monthly) Product per paid plan in the Dodo dashboard
# (Products > New Product), priced to match packages/shared/src/plans.ts,
# then paste each Product's id (pdt_...) below.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_AGENCY=
# One-time Products, one per entry in packages/shared/src/plans.ts CREDIT_PACKS.
DODO_PRODUCT_PACK_2=
DODO_PRODUCT_PACK_5=
DODO_PRODUCT_PACK_10=
DODO_PRODUCT_PACK_25=

# ---------- Mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Botfolks <hello@botfolks.in>"
UPLOAD_DIR=../../uploads
CRAWL_MAX_PAGES=50

# js = plain MySQL, local dev (use db/local/001_init_local.sql). native = MariaDB 11.8 VECTOR, production.
VECTOR_MODE=js
