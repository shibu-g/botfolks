{
  "name": "botfolks",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" --filter \"!./apps/site\" dev",
    "dev:api": "pnpm --filter @botfolks/api dev",
    "dev:worker": "pnpm --filter @botfolks/worker dev",
    "dev:dashboard": "pnpm --filter @botfolks/dashboard dev",
    "dev:widget": "pnpm --filter @botfolks/widget dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
